+fn expand_leading_param_file(args: Vec<String>) -> Result<Vec<String>, OptionError> {
+    match args.get(1).and_then(|a| a.strip_prefix('@')) {
+        Some(param_file) => {
+            let param_file = param_file.to_string();
+            let file_args = read_file_to_array(&param_file).map_err(OptionError::Generic)?;
+            eprintln!(
+                "process_wrapper: expand_leading_param_file: file={} count={} first={:?} last={:?}",
+                param_file,
+                file_args.len(),
+                file_args.first(),
+                file_args.last(),
+            );
+            let mut expanded = vec![args[0].clone()];
+            expanded.extend(file_args);
+            expanded.extend(args.into_iter().skip(2));
+            Ok(expanded)
+        }
+        None => {
+            eprintln!(
+                "process_wrapper: expand_leading_param_file: no leading @param file, argv={:?}",
+                args,
+            );
+            Ok(args)
+        }
+    }
+}
