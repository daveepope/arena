+fn collapse_into_param_file(args: &[String], key: Option<&str>) -> Result<Vec<String>, OptionError> {
+    if args.len() <= 1 {
+        return Ok(args.to_vec());
+    }
+    let param_file = format!("{}.final_args", key.unwrap_or("process_wrapper_rustc_args"));
+    let format_err = |err: io::Error| {
+        OptionError::Generic(format!(
+            "{} writing path: {:?}, current directory: {:?}",
+            err,
+            param_file,
+            std::env::current_dir()
+        ))
+    };
+    let mut flattened: Vec<String> = Vec::new();
+    for arg in args {
+        // rustc's own @file expansion is not recursive: inline any nested
+        // @file reference's content rather than leaving it as a literal
+        // "@path" line, which rustc would otherwise try to open verbatim.
+        match arg.strip_prefix('@') {
+            Some(nested) => {
+                flattened.extend(read_file_to_array(nested).map_err(OptionError::Generic)?);
+            }
+            None => flattened.push(arg.clone()),
+        }
+    }
+    let mut writer = io::BufWriter::new(File::create(&param_file).map_err(format_err)?);
+    for line in &flattened {
+        writeln!(writer, "{line}").map_err(format_err)?;
+    }
+    writer.flush().map_err(format_err)?;
+    // Only dump full content for the one target we're actively debugging;
+    // every other crate's compile also goes through this path and would
+    // otherwise flood the log.
+    if param_file.contains("arena-ffi") {
+        eprintln!(
+            "process_wrapper: collapse_into_param_file: file={} pre_count={} flattened_count={} full={:?}",
+            param_file,
+            args.len(),
+            flattened.len(),
+            flattened,
+        );
+    }
+    Ok(vec![format!("@{param_file}")])
+}
