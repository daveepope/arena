module(
    name = "arena",
    version = "3.4.0",
)

arena_version_ext = use_extension("//tools:arena_version.bzl", "arena_version")
use_repo(arena_version_ext, "arena_version")

bazel_dep(name = "rules_python", version = "0.34.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_java", version = "9.0.0")
bazel_dep(name = "rules_jvm_external", version = "6.6")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "openssl",
    sha256 = "b28c91532a8b65a1f983b4c28b7488174e4a01008e29ce8e69bd789f28bc2a89",
    strip_prefix = "openssl-3.5.5",
    urls = ["https://github.com/openssl/openssl/releases/download/openssl-3.5.5/openssl-3.5.5.tar.gz"],
    build_file = "//third_party:openssl.BUILD.bazel",
)

_TRIVY_VERSION = "0.72.0"

http_archive(
    name = "trivy_linux_x86_64",
    build_file_content = """exports_files(["trivy"])""",
    sha256 = "bbb64b9695866ce4a7a8f5c9592002c5961cab378577fa3f8a040df362b9b2ea",
    urls = ["https://github.com/aquasecurity/trivy/releases/download/v{v}/trivy_{v}_Linux-64bit.tar.gz".format(v = _TRIVY_VERSION)],
)

http_archive(
    name = "trivy_macos_x86_64",
    build_file_content = """exports_files(["trivy"])""",
    sha256 = "ee5e60df8a98e5b89fd74a6d86f9e5c7e9a266a35002cb1e43291698b3bfee08",
    urls = ["https://github.com/aquasecurity/trivy/releases/download/v{v}/trivy_{v}_macOS-64bit.tar.gz".format(v = _TRIVY_VERSION)],
)

http_archive(
    name = "trivy_macos_arm64",
    build_file_content = """exports_files(["trivy"])""",
    sha256 = "88f208680dc05da2b459e19b4f5aa2b4dc7c2117892ba4aab2ae63baba330016",
    urls = ["https://github.com/aquasecurity/trivy/releases/download/v{v}/trivy_{v}_macOS-ARM64.tar.gz".format(v = _TRIVY_VERSION)],
)

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    java_toolchains,
    "remote_java_tools",
    "remote_java_tools_linux",
    "remote_java_tools_windows",
    "remote_java_tools_darwin_x86_64",
    "remote_java_tools_darwin_arm64",
)
_ARENA_JDK25 = [
    "remotejdk25_linux",
    "remotejdk25_linux_aarch64",
    "remotejdk25_macos",
    "remotejdk25_macos_aarch64",
    "remotejdk25_win",
    "remotejdk25_win_arm64",
]

[use_repo(java_toolchains, repo + "_toolchain_config_repo") for repo in _ARENA_JDK25]

[register_toolchains("@" + repo + "_toolchain_config_repo//:all") for repo in _ARENA_JDK25]

arena_java_maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

arena_java_maven.artifact(
    name = "arena_java_maven",
    group = "io.grpc",
    artifact = "grpc-core",
    version = "1.58.1",
    exclusions = ["io.grpc:grpc-util"],
)
arena_java_maven.install(
    name = "arena_java_maven",
    artifacts = [
        "net.java.dev.jna:jna:5.14.0",
        "org.slf4j:slf4j-api:2.0.16",
        "com.fasterxml.jackson.core:jackson-databind:2.18.8",
        "org.junit.jupiter:junit-jupiter-api:5.11.4",
        "org.junit.jupiter:junit-jupiter-params:5.11.4",
        "org.junit.jupiter:junit-jupiter-engine:5.11.4",
        "org.junit.platform:junit-platform-console:1.11.4",
        "org.apache.kafka:kafka-clients:3.9.0",
        "org.springframework.boot:spring-boot-starter-web:3.5.3",
        "org.springframework.boot:spring-boot-starter-jdbc:3.5.3",
        "org.springframework.boot:spring-boot-starter-validation:3.5.3",
        "org.springframework.boot:spring-boot-starter-oauth2-resource-server:3.5.3",
        "org.postgresql:postgresql:42.7.12",
        "com.microsoft.sqlserver:mssql-jdbc:12.8.2.jre11",
        "software.amazon.awssdk:eventbridge:2.29.29",
        "software.amazon.awssdk:sqs:2.29.29",
        "software.amazon.awssdk:auth:2.29.29",
        "software.amazon.awssdk:regions:2.29.29",
        "software.amazon.awssdk:url-connection-client:2.29.29",
        "org.springframework.boot:spring-boot-starter-logging:3.5.3",
        "ch.qos.logback:logback-classic:1.5.12",
        "io.temporal:temporal-sdk:1.30.1",
    ],
    fail_on_missing_checksum = False,
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(arena_java_maven, "arena_java_maven")

# Python toolchain and pip deps (for arena-pytest).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    configure_coverage_tool = True,
)
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//arena-pytest:requirements_lock.txt",
)
pip.parse(
    hub_name = "pip_examples",
    python_version = "3.12",
    requirements_lock = "//examples:requirements_lock.txt",
)
use_repo(pip, "pip", "pip_examples")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.92.0"],
    # bfd is Linux-only; macOS uses the default linker and fails if we pass -fuse-ld=bfd.
    extra_rustc_flags_triples = {
        "x86_64-unknown-linux-gnu": ["-Clink-arg=-fuse-ld=bfd"],
        "aarch64-unknown-linux-gnu": ["-Clink-arg=-fuse-ld=bfd"],
    },
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "openssl-sys",
    build_script_data = ["@openssl//:gen_dir"],
    build_script_env = {
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "1",
        "OPENSSL_DIR": "$(execpath @openssl//:gen_dir)",
        "OPENSSL_LIB_DIR": "$(execpath @openssl//:gen_dir)/lib64",
        "OPENSSL_INCLUDE_DIR": "$(execpath @openssl//:gen_dir)/include",
    },
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    lockfile = "//:Cargo.Bazel.lock",
)
inject_repo(crate, "openssl")
use_repo(crate, "crates")