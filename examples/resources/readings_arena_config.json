{
  "schema_version": 1,
  "network_name": "arena-readings-api-network",
  "docker_image_tag": "readings-api-axum-container-image",
  "closed_arena_name": "readings-api-arena",
  "match_name": "readings-api-happy-path",
  "temp_directory_prefix": "readings-api-image-build-ctx-",
  "kafka_consumer_group_label": "readings-api-consumer",
  "postgres_image": "14.20-trixie",
  "dependency_names": {
    "oauth": "readings-api-oauth",
    "postgres": "readings-api-postgres",
    "kafka": "readings-api-kafka",
    "mssql": "readings-api-mssql",
    "calibration_http": "readings-api-calibration"
  },
  "component_names": {
    "executable": "readings-api-web-app",
    "containerized": "readings-api-containerized-web-app"
  },
  "container_names": {
    "postgres": "readings-api-postgres",
    "kafka": "readings-api-kafka",
    "mssql": "readings-api-mssql",
    "calibration": "readings-api-calibration"
  },
  "playbook_names": {
    "calibration_default": "readings-api-calibration-default",
    "calibration_outage_managed": "readings-api-calibration-outage-managed",
    "calibration_outage_fixture_scope": "readings-api-calibration-outage-fixture-scope",
    "validation_db_scoped": "readings-api-validation-db-scoped",
    "localstack_session": "readings-api-localstack-session"
  },
  "ports": {
    "exec_web_app": 3010,
    "docker_web_host": 3112,
    "kafka_host": 9093,
    "calibration_host": 3011,
    "postgres_host": 5560,
    "mssql_host": 1438
  },
  "database": {
    "postgres_name": "readings_db",
    "postgres_user": "readings_user",
    "postgres_password": "readings_password",
    "mssql_name": "validationDb",
    "mssql_user": "sa",
    "mssql_password": "yourStrong(!)Password"
  },
  "kafka_topic": "readings",
  "calibration_validate_path": "/api/v1/validate"
}
